# --- Site ---
# Em produção: https://synchim.viviannedossantos.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- PayPal ---
# Use sandbox while testing. Switch to live for production.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- Resend ---
RESEND_API_KEY=
RESEND_FROM="SyncHim <noreply@viviannedossantos.com>"

# --- Prices in USD (cents are not used; PayPal v2 takes decimal strings) ---
PRICE_TIER1_USD=39.00
PRICE_TIER2_USD=87.00
PRICE_UPGRADE_NO_USD=19.00

# --- Admin (produção de conteúdo) ---
# Lista de emails (separados por vírgula) com acesso a /admin
ADMIN_EMAILS=vivianne@example.com
# Password partilhada do admin (em produção: trocar por magic link)
ADMIN_PASSWORD=
# Bucket público no Supabase Storage (criar manualmente)
SUPABASE_STORAGE_BUCKET=synchim-assets

# --- GitHub Actions dispatch (render workflows) ---
# PAT classic com scopes: repo, workflow
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO_OWNER=vivnasc
GITHUB_REPO_NAME=SyncHim
GITHUB_DISPATCH_REF=main

# --- ElevenLabs (TTS p/ vídeos com narração) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# --- Suno (música ambiente gerada por IA) ---
# Provider compatível com Suno API (sunoapi.com, api.box, similar)
SUNO_API_URL=https://api.sunoapi.com/api/v1
SUNO_API_KEY=
# Opcional. Vazio = provider usa o último modelo (recomendado).
SUNO_MODEL=

# --- Claude (geração de copy) ---
ANTHROPIC_API_KEY=
